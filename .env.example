# Copie para .env (que o .gitignore já ignora) e preencha. NUNCA coloque valores reais neste arquivo de exemplo.

# Banco PostgreSQL. Em hospedagem, use a connection string do provedor (Neon, Supabase, Render...).
# Fora da sua máquina a conexão usa TLS com verificação de certificado automaticamente.
DATABASE_URL=postgres://usuario:senha@localhost:5432/shaq

# Produção: ligue estas três
NODE_ENV=production
TRUST_PROXY=1
APP_URL=https://seu-app.exemplo.com

# Porta (muitos hospedeiros definem sozinhos)
PORT=3000

# Notificações (gere com: npm run gerar-vapid). A chave privada é segredo.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# Só se o banco estiver em rede privada sem TLS (raro): DB_SSL=off
